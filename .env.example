# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# On Vercel these same three go in Project Settings, Environment Variables, then redeploy.
#
# Only ever put PUBLISHABLE or ANON values here. Anything in a VITE_ variable is
# compiled into the public bundle and is readable by anyone who opens the page source.
# A Supabase secret or service_role key must never appear in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_N8N_WEBHOOK_BASE=https://your-n8n-instance/webhook
